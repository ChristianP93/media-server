# ===========================================
# Media Stack - Environment Configuration
# ===========================================
# Copy this file to .env and customize the values
# cp .env.example .env

# -------------------------------------------
# User/Group IDs
# -------------------------------------------
# Run 'id' in terminal to find your PUID and PGID
# These ensure proper file permissions
PUID=1000
PGID=1000

# -------------------------------------------
# Timezone
# -------------------------------------------
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Rome

# -------------------------------------------
# Data Directory
# -------------------------------------------
# Base directory for all media data (downloads, movies, tv shows)
# This path must exist and be writable by the user specified above
#
# Structure created inside ROOT_DIR:
#   /data
#   ├── torrents/     # Download directory for qBittorrent
#   └── media/
#       ├── movies/   # Radarr library
#       └── tv/       # Sonarr library
#
ROOT_DIR=/Users/christian/media-data

# -------------------------------------------
# Domain Configuration
# -------------------------------------------
# Your domain for accessing services
# For local development: media.local (requires /etc/hosts configuration)
# For production: your-domain.com
#
# Services will be available at:
#   - sonarr.DOMAIN    (TV shows)
#   - radarr.DOMAIN    (Movies)
#   - prowlarr.DOMAIN  (Indexers)
#   - bazarr.DOMAIN    (Subtitles)
#   - qbit.DOMAIN      (Torrent client)
#   - requests.DOMAIN  (Overseerr)
#   - media.DOMAIN     (Plex)
#   - stats.DOMAIN     (Tautulli)
#
DOMAIN=media.local

# -------------------------------------------
# HTTPS (Optional - requires public domain)
# -------------------------------------------
# Set to true to enable HTTPS via Let's Encrypt
# Default: false (HTTP only for local development)
ENABLE_HTTPS=false

# Email for Let's Encrypt certificate notifications
# Only required if ENABLE_HTTPS=true
ACME_EMAIL=your-email@example.com

# -------------------------------------------
# VPN Configuration (ProtonVPN)
# -------------------------------------------
# Credentials for ProtonVPN (OpenVPN/WireGuard)
# You can find these in your ProtonVPN account dashboard (not your login password!)
VPN_USER=your_openvpn_username
VPN_PASSWORD=your_openvpn_password
# Comma separated list of countries (e.g. Netherlands,Switzerland)
VPN_COUNTRIES=Netherlands

# -------------------------------------------
# Plex Media Server
# -------------------------------------------
# Get your claim token at: https://www.plex.tv/claim/
# The token is valid for 4 minutes after generation
# Leave empty after initial setup
PLEX_CLAIM=
