# ===========================================
# Setup Configuration - Media Stack
# ===========================================
# Questo file contiene le configurazioni per lo script di setup automatico.
# Modifica i valori secondo le tue preferenze prima di eseguire setup.sh

# -------------------------------------------
# Credenziali Servizi
# -------------------------------------------
# Queste credenziali verranno impostate su tutti i servizi

# qBittorrent
QBIT_USERNAME="admin"
QBIT_PASSWORD="changeme123"

# Credenziali comuni per Sonarr/Radarr/Prowlarr/Bazarr
# (ogni servizio avrà le stesse credenziali per semplicità)
ARR_USERNAME="admin"
ARR_PASSWORD="changeme123"

# -------------------------------------------
# Percorsi (devono corrispondere a .env)
# -------------------------------------------
# Percorso download qBittorrent (interno al container)
DOWNLOAD_PATH="/data/torrents"
INCOMPLETE_PATH="/data/torrents/incomplete"

# Percorsi librerie media (interno al container)
TV_PATH="/data/media/tv"
MOVIES_PATH="/data/media/movies"

# -------------------------------------------
# Quality Profiles
# -------------------------------------------
# Profilo qualità preferito (verrà selezionato se disponibile)
# Opzioni comuni: "HD-1080p", "HD-720p", "Ultra-HD", "Any"
PREFERRED_QUALITY="HD-1080p"

# -------------------------------------------
# Sottotitoli (Bazarr)
# -------------------------------------------
# Lingue sottotitoli (codici ISO 639-2)
# Italiano = ita, English = eng, Spanish = spa, etc.
SUBTITLE_LANGUAGES="ita,eng"

# Provider sottotitoli da abilitare (separati da virgola)
# Disponibili: opensubtitles, opensubtitlescom, addic7ed, subscene, podnapisi
# Nota: opensubtitlescom richiede account gratuito su opensubtitles.com
SUBTITLE_PROVIDERS="opensubtitles,podnapisi"

# -------------------------------------------
# Indexer Pubblici (Prowlarr)
# -------------------------------------------
# Indexer da aggiungere automaticamente (separati da virgola)
# Questi sono indexer pubblici che non richiedono account
INDEXERS="1337x,LimeTorrents,EZTV,Nyaa,YTS,ThePirateBay"

# -------------------------------------------
# Avanzate
# -------------------------------------------
# Timeout attesa servizi (secondi)
STARTUP_TIMEOUT=120

# Abilita autenticazione dopo setup (consigliato: true)
ENABLE_AUTH_AFTER_SETUP="true"
